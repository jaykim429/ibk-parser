{
  "regulationName": "거치식예금규정",
  "mappings": {},
  "articles": [
    {
      "regulation_name": "제1조(목적)",
      "regulation_content": "이 규정은 거치식예금의 업무처리 방법 및 절차를 규정함을 목적으로 한다.",
      "type": "조",
      "jo": "1",
      "sub_articles": []
    },
    {
      "regulation_name": "제2조(용어정의)",
      "regulation_content": "거치식예금(이하 “이 예금”이라 한다)이란 정기예금, 양도성예금증서, 표지어음 등과 같이 거래를 시작할 때 맡긴 예금을 만기에 찾는 예금을 말한다.",
      "type": "조",
      "jo": "2",
      "sub_articles": []
    },
    {
      "regulation_name": "제3조(준용)",
      "regulation_content": "이 규정에서 정하지 아니한 사항은 예금규정을 준용한다.",
      "type": "조",
      "jo": "3",
      "sub_articles": []
    },
    {
      "regulation_name": "제4조(거래대상자)",
      "regulation_content": "이 예금의 거래대상자는 제한을 두지 아니한다.",
      "type": "조",
      "jo": "4",
      "sub_articles": []
    },
    {
      "regulation_name": "제5조(입금액)",
