        {
          "regulation_name": "제10조제2항",
          "regulation_content": "계약변경 신청일부터 계약변경후 만기일 전날까지의 예입기간에 대하여는 계약변경 신청일의 약정이율을 적용한다.",
          "type": "항",
          "jo": "10",
          "hang": "2"
        }
      ]
