    {
      "regulation_name": "부칙<2015.3.27> 제1조(시행일)",
      "regulation_content": "이규정은2014년10월31일부터시행한다.",
      "type": "부칙",
      "jo": "1"
    },
    {
      "regulation_name": "부칙<2015.3.27> 제2조(경과조치)",
      "regulation_content": "제3조제1항의개정규정에도불구하고시행일현재재임\n중인임원은2014년10월31일까지근속한기간에대한업적연봉은종전\n규정대로퇴직금산정시포함하여계산한다.",
      "type": "부칙",
      "jo": "2"
    }
