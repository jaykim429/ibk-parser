        },
        {
          "regulation_name": "제10조제3항",
          "regulation_content": "업적성과급을 거짓이나 그 밖의 부정한 방법으로 지급받은 자에게는 그 지급한 업적성과급을 환수한다.",
          "type": "항",
          "jo": "10",
          "hang": "3"
        },
        {
          "regulation_name": "제10조의2제1항",
          "regulation_content": "집행간부 및 준법감시인의 성과연봉은 제9조, 제10조, 제11조에 의거 지급한다.",
          "type": "항",
          "jo": "10조의2",
