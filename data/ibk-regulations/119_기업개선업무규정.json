        {
          "regulation_name": "제9조제1항",
          "regulation_content": "영업점은 체인지업 지원이 필요한 기업과 협의하여 경영정상화 방안을 마련하고 주무부서에 지원심사를 신청할 수 있다.",
          "type": "항",
          "jo": "9",
          "hang": "1"
        },
        {
          "regulation_name": "제9조제2항",
          "regulation_content": "유관부서는 해당기업 및 영업점에게 체인지업을 신청할 것을 권고하거나 주무부서에 추천할 수 있다.",
          "type": "항",
          "jo": "9",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제10조(신청시 고려사항)",
      "regulation_content": "",
      "type": "조",
      "jo": "10",
      "sub_articles": [
        {
          "regulation_name": "제10조제1항",
          "regulation_content": "체인지업 신청시에는 사업전망, 자구계획 등을 고려하여 경영정상화 가능 여부를 미리 검토하여야 한다.",
