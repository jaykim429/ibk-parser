    {
      "regulation_name": "제1조(목적)",
      "regulation_content": "이 규정은 비예금상품의 기획·선정 및 판매, 사후관리에 관한 사항을 협의하기 위한 비예금상품위원회(이하'위원회'라 한다)의 구성 및 운영에 관한 사항을 정함을 목적으로 한다.",
      "type": "조",
      "jo": "1",
      "sub_articles": []
    },
    {
      "regulation_name": "제2조(정의)",
      "regulation_content": "",
