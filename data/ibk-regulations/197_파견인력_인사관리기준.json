    },
    {
      "regulation_name": "제4조(계약체결 및 배치)",
      "regulation_content": "",
      "type": "조",
      "jo": "4",
      "sub_articles": [
        {
          "regulation_name": "제4조제1항",
          "regulation_content": "소관부점장은 파견인력에 대하여 근로자파견회사와 근로파견계약을 체결하고, 파견인력이 필요한 부점장의 요청에 따라 해당인력을 배치한다.",
          "type": "항",
          "jo": "4",
          "hang": "1"
        },
        {
          "regulation_name": "제4조제2항",
          "regulation_content": "파견인력에 대한 복무관리 등 제반 사항은 근로자파견회사와의 계약에 따른다.",
          "type": "항",
          "jo": "4",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제5조(근무기간)",
      "regulation_content": "근로자파견회사로부터 배치된 파견인력에 대하여는 1년 이내의 기간을 단위로 근무토록 하되, 최장 2년을 초과하여 근무하게 할 수 없다.",
      "type": "조",
      "jo": "5",
      "sub_articles": []
    },
    {
      "regulation_name": "제6조(인력관리)",
      "regulation_content": "파견인력의 인력관리는 근로자파견회사에서 관리한다.",
      "type": "조",
      "jo": "6",
      "sub_articles": []
    },
    {
      "regulation_name": "제7조(복무관리)",
      "regulation_content": "파견인력의 복무관리는 소속부점장이 행한다.",
      "type": "조",
      "jo": "7",
      "sub_articles": []
    },
    {
      "regulation_name": "제8조(복무자세)",
      "regulation_content": "파견인력은 근로자파견계약서상의 담당직무를 성실히 수행하여야 하며, 「계약인력 인사관리기준」제11조 각호의 사항을 준수하여야 한다.",
      "type": "조",
      "jo": "8",
      "sub_articles": []
    },
    {
      "regulation_name": "제9조(근무시간과 휴게시간)",
      "regulation_content": "파견인력의 근무시간 및 휴게시간은 근로자파견계약서에서 정하는 바에 따르되, 「계약인력 인사관리기준」제12조를 준용할 수 있다.",
      "type": "조",
      "jo": "9",
      "sub_articles": []
    },
    {
