              "byeolpyo": null
            }
          ]
        },
        {
          "regulation_name": "제3조제2항",
          "regulation_content": "파견인력의 해당 직무별 구체적인 업무내용은 근로자파견회사와 체결한 근로자파견계약서에서 정하는 바에 따른다.",
          "type": "항",
          "jo": "3",
          "hang": "2"
        }
