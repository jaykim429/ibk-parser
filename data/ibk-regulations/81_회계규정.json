{
  "regulationName": "회계규정",
  "mappings": {},
  "articles": [
    {
      "regulation_name": "제1조(목적)",
      "regulation_content": "이규정은회계업무에관한주요기준과절차를규정함을목적\n으로한다.",
      "type": "조",
      "jo": "1",
      "sub_articles": []
    },
    {
      "regulation_name": "제2조(적용범위)",
      "regulation_content": "",
      "type": "조",
      "jo": "2",
      "sub_articles": [
        {
          "regulation_name": "제2조제1항",
          "regulation_content": "회계업무는관계법령등에특별히정한경우를제외\n하고는이규정이정하는바에따른다.",
          "type": "항",
          "jo": "2",
          "hang": "1"
        },
        {
          "regulation_name": "제2조제2항",
          "regulation_content": "이규정과관련한세부사항은「회계처리지침」에서정하는바에\n따르며,회계처리지침에서 정하지아니한사항또는구체적인회계처리\n방법은「IFRS실무기준」에따른다.",
          "type": "항",
          "jo": "2",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제3조(회계연도)",
      "regulation_content": "당행의회계연도는중소기업은행법 및정관에서정하는\n바에따른다.",
      "type": "조",
      "jo": "3",
      "related_laws": [
        {
          "law_name": "중소기업은행법",
          "original_text": "중소기업은행법",
          "jo": null,
          "hang": null,
          "ho": null,
          "mok": null,
          "byeolpyo": null
        }
      ],
      "sub_articles": []
    },
    {
      "regulation_name": "제4조(회계단위)",
      "regulation_content": "",
      "type": "조",
      "jo": "4",
      "sub_articles": [
        {
          "regulation_name": "제4조제1항",
          "regulation_content": "회계단위는총계정원장설치부점으로한다.",
          "type": "항",
          "jo": "4",
          "hang": "1"
        },
        {
          "regulation_name": "제4조제2항",
          "regulation_content": "각회계단위의회계는본부에소속된회계단위에서총괄한다.",
          "type": "항",
          "jo": "4",
          "hang": "2"
        },
        {
          "regulation_name": "제4조제3항",
          "regulation_content": "제1항에서규정한회계단위이외의부속회계는직제에따라소속된\n회계단위에서관장한다.",
          "type": "항",
          "jo": "4",
          "hang": "3"
        },
        {
          "regulation_name": "제4조제4항",
          "regulation_content": "회계단위간의거래는본지점계정을두어처리한다.",
          "type": "항",
          "jo": "4",
          "hang": "4"
        }
      ]
    },
    {
      "regulation_name": "제5조(회계관계업무의 위임)",
      "regulation_content": "",
      "type": "조",
      "jo": "5",
      "sub_articles": [
        {
          "regulation_name": "제5조제1항",
          "regulation_content": "회계에관한사무는소속직원에게위임할\n수있다.",
          "type": "항",
          "jo": "5",
          "hang": "1"
        },
        {
          "regulation_name": "제5조제2항",
          "regulation_content": "제1항의규정에따른사무의위임은그직을지정함으로써이에갈음1997.11.29 제정\n1998.12.23제1차개정\n2000.1.3제2차개정\n(전부개정)\n2002.6.21제3차개정\n2010.12.6제4차개정\n(전부개정)\n할수있다.",
          "type": "항",
          "jo": "5",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제6조(회계담당)",
      "regulation_content": "",
      "type": "조",
      "jo": "6",
      "sub_articles": [
        {
          "regulation_name": "제6조제1항",
          "regulation_content": "각회계단위에다음각호의회계담당을둔다.\n1.예산담당\n예산에관한사무를처리하는예산관리자․부문예산관리자 및예산담\n당자\n2.출납담당\n현금의수입및지출을담당하는자\n3.계산담당\n각회계단위의제계정을종합집계하는사무및결산에관한사무를\n담당하는자\n4.자산관리담당\n고정자산,물품및부외자산의관리를담당하는자\n5.유가증권담당\n유가증권의관리에관한사무를담당하는자\n6.계약담당\n매매,대차,도급및기타계약에관한사무를담당하는자",
          "type": "항",
          "jo": "6",
          "hang": "1"
        },
        {
          "regulation_name": "제6조제2항",
          "regulation_content": "제1항의회계담당외에별도담당의설치가필요한경우에는그\n담당자를둘수있다.",
          "type": "항",
          "jo": "6",
          "hang": "2"
        },
        {
          "regulation_name": "제6조제3항",
          "regulation_content": "제1항및제2항의회계담당에관하여필요하다고인정하는때에는\n따로취급자를지정하여그사무의전부를대리하게하거나일부를분장\n하게할수있다.",
          "type": "항",
          "jo": "6",
          "hang": "3"
        }
      ]
    },
    {
      "regulation_name": "제7조(회계처리의일반원칙)",
      "regulation_content": "",
      "type": "조",
      "jo": "7",
      "sub_articles": [
        {
          "regulation_name": "제7조제1항",
          "regulation_content": "회계처리에관하여이규정에서정하는것\n외에는한국채택국제회계기준 ,금융위원회가정하는은행관련회계처리\n기준등의외규를준용한다.",
          "type": "항",
          "jo": "7",
          "hang": "1"
        },
        {
          "regulation_name": "제7조제2항",
          "regulation_content": "회계처리에적용되는기준은매회계연도에계속하여적용하여야하며\n정당한사유없이이를변경하여서는안된다.",
          "type": "항",
          "jo": "7",
          "hang": "2"
        },
        {
          "regulation_name": "제7조제3항",
          "regulation_content": "회계처리는신뢰할수있도록객관적인자료와증거에따라공정하게\n처리하여야한다.",
          "type": "항",
          "jo": "7",
          "hang": "3"
        },
        {
          "regulation_name": "제7조제4항",
          "regulation_content": "한국채택국제회계기준에 따라금융상품등자산및부채에대해\n공정가치평가를적용한다.",
          "type": "항",
          "jo": "7",
          "hang": "4"
        }
      ]
    },
    {
      "regulation_name": "제8조(회계업무의인계인수)",
      "regulation_content": "회계업무의인계인수는문서의내용을확인하\n여인계자및인수자가기명날인또는서명하여야한다.",
      "type": "조",
      "jo": "8",
      "sub_articles": []
    },
    {
      "regulation_name": "제9조(회계관계직원의 책임)",
      "regulation_content": "회계관계직원은 관계법령및규정이정하는\n바에따라성실하게그직분에따른회계처리를하여야한다.",
      "type": "조",
      "jo": "9",
      "sub_articles": []
    },
    {
      "regulation_name": "제10조(회계서류의보관등)",
      "regulation_content": "회계서류의보관․열람․보존․편철․대출및\n복사에관하여는은행장이별도정하는바에따른다.\n제2장회계관리",
      "type": "조",
      "jo": "10",
      "sub_articles": []
    },
    {
      "regulation_name": "제11조(회계통제)",
      "regulation_content": "",
      "type": "조",
      "jo": "11",
      "sub_articles": [
        {
          "regulation_name": "제11조제1항",
          "regulation_content": "각부점장은다음각호에해당하는업무가적절한\n승인등정당한절차를통해이루어지도록하여야한다.\n1.소관업무에대한회계정책및회계업무처리절차의수립\n2.중요한회계처리\n3.기타중요하다고판단되는회계관련업무",
          "type": "항",
          "jo": "11",
          "hang": "1"
        },
        {
          "regulation_name": "제11조제2항",
          "regulation_content": "각부점장은소관업무와관련된계정잔액에대하여정기적으로계정의\n적정성여부를검토하고,관련원장등과의일치여부를검증하여야한다.",
          "type": "항",
          "jo": "11",
          "hang": "2"
        },
        {
          "regulation_name": "제11조제3항",
          "regulation_content": "회계주무부서장은 은행의전계정과목과연결계정과목에대하여\n정기적으로적정성여부를검토하여야한다.",
          "type": "항",
          "jo": "11",
          "hang": "3"
        }
      ]
    },
    {
      "regulation_name": "제12조(신상품등에대한회계처리)",
      "regulation_content": "각부점장은신상품등새로운업무나\n제도를개발하여시행하고자할경우에는회계처리방법등에대하여\n회계주무부서장과 사전협의를하여야한다.",
      "type": "조",
      "jo": "12",
      "sub_articles": []
    },
    {
      "regulation_name": "제13조(회계유관사항에대한사전협의)",
      "regulation_content": "각부점장은외규또는내규의변\n경등으로인한업무처리기준이나전산시스템의변경이재무제표의작\n성,회계처리방법등에영향을미칠것으로판단되는경우회계주무부\n서장과사전에협의하여시행하여야한다.",
      "type": "조",
      "jo": "13",
      "sub_articles": []
    },
    {
      "regulation_name": "제14조(회계처리의조정)",
      "regulation_content": "회계주무부서장은 동일또는유사한거래에대한\n회계처리기준및방법이은행의부서및자회사간에상이하거나이견이\n생길경우이를조정할수있다.",
      "type": "조",
      "jo": "14",
      "sub_articles": []
    },
    {
      "regulation_name": "제15조(회계시스템등에대한통제)",
      "regulation_content": "회계주무부서장은 회계정보기록의 유\n지와자산의보호등을위하여필요한통제조치를취할수있다.\n제3장회계장표\n제1절통칙",
      "type": "조",
      "jo": "15",
      "sub_articles": []
    },
    {
      "regulation_name": "제16조(장표에따른회계처리)",
      "regulation_content": "회계는전표․장부․증빙서․기타서류에따\n라처리하여야한다.",
      "type": "조",
      "jo": "16",
      "sub_articles": []
    },
    {
      "regulation_name": "제17조(전산화에따른회계장표의생략)",
      "regulation_content": "",
      "type": "조",
      "jo": "17",
      "sub_articles": [
        {
          "regulation_name": "제17조제1항",
          "regulation_content": "회계업무의전산화에따라이\n규정에따른장표의비치등은이를생략할수있다.",
          "type": "항",
          "jo": "17",
          "hang": "1"
        },
        {
          "regulation_name": "제17조제2항",
          "regulation_content": "제1항의규정에따라장표의비치를생략한경우에도감독기관이나\n이해관계자의요구가있으면회계장표와내용이동일한대용장표를\n신속히제공할수있는필요한조치를취하여야한다.",
          "type": "항",
          "jo": "17",
          "hang": "2"
        },
        {
          "regulation_name": "제17조제3항",
          "regulation_content": "제1항의규정에따라생략할수있는장표의종류는온라인으로\n처리하는업무에관한원장으로한다.",
          "type": "항",
          "jo": "17",
          "hang": "3"
        }
      ]
    },
    {
      "regulation_name": "제18조(회계장표의양식)",
      "regulation_content": "장표의양식과규격은은행장이별도정하는바에\n따른다.",
      "type": "조",
      "jo": "18",
      "sub_articles": []
    },
    {
      "regulation_name": "제19조(회계장표의정정)",
      "regulation_content": "",
      "type": "조",
      "jo": "19",
      "sub_articles": [
        {
          "regulation_name": "제19조제1항",
          "regulation_content": "회계장표를정정할때에는정정부분에정정의\n표시를하고정정자가날인또는서명하여야한다.",
          "type": "항",
          "jo": "19",
          "hang": "1"
        },
        {
          "regulation_name": "제19조제2항",
          "regulation_content": "금액은그일부만을정정할수없다.\n제2절전표",
          "type": "항",
          "jo": "19",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제20조(전표의내용)",
      "regulation_content": "",
      "type": "조",
      "jo": "20",
      "sub_articles": [
        {
          "regulation_name": "제20조제1항",
          "regulation_content": "전표에는계정과목을표시하여야한다.다만,증\n빙서를대용전표로사용하는경우에있어서증빙서의제목등으로보아\n쉽게판단할수있을때에는계정과목을표시하지아니할수있다.",
          "type": "항",
          "jo": "20",
          "hang": "1"
        },
        {
          "regulation_name": "제20조제2항",
          "regulation_content": "전표의합계금액은이를정정하지못한다.",
          "type": "항",
          "jo": "20",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제21조(전표의대용)",
      "regulation_content": "증빙서는전표로대용할수있으며,전표의대용범위는\n은행장이별도정하는바에따른다.이경우증빙서의서식에는전표의\n기능이포함되어야한다.",
      "type": "조",
      "jo": "21",
      "sub_articles": []
    },
    {
      "regulation_name": "제22조(전표의작성․정리)",
      "regulation_content": "전표의작성및정리등에관하여는은행장이\n별도정하는바에따른다.\n제3절장부",
      "type": "조",
      "jo": "22",
      "sub_articles": []
    },
    {
      "regulation_name": "제23조(회계장부의종류)",
      "regulation_content": "",
      "type": "조",
      "jo": "23",
      "sub_articles": [
        {
          "regulation_name": "제23조제1항",
          "regulation_content": "회계장부는주요부와보조부로구분한다.",
          "type": "항",
          "jo": "23",
          "hang": "1"
        },
        {
          "regulation_name": "제23조제2항",
          "regulation_content": "주요부는전표철과총계정잔액장으로 하고보조부는각계정원장및\n명세장으로한다.",
          "type": "항",
          "jo": "23",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제24조(기장사무의분리)",
      "regulation_content": "주요부와보조부는그기장사무의담당자를달\n리하여야한다.다만,회계단위의규모,업무의성질에따라예외로할\n수있다.",
      "type": "조",
      "jo": "24",
      "sub_articles": []
    },
    {
      "regulation_name": "제25조(장부의작성)",
      "regulation_content": "장부의기입․마감․이월․폐쇄등에관하여는은\n행장이별도정하는바에따른다.\n제4절증빙서",
      "type": "조",
      "jo": "25",
      "sub_articles": []
    },
    {
      "regulation_name": "제26조(증빙서의범위)",
      "regulation_content": "",
      "type": "조",
      "jo": "26",
      "sub_articles": [
        {
          "regulation_name": "제26조제1항",
