    {
      "regulation_name": "제1조(목적)",
      "regulation_content": "퇴직금규정(이하 “규정”이라 함)의 시행에 필요한 세부적인 사항을 규정함을 목적으로 한다.",
      "type": "조",
      "jo": "1",
      "sub_articles": []
