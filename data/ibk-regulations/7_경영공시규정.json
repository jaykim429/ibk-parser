              "ho": null,
              "mok": null,
              "byeolpyo": null
            }
          ]
        },
        {
          "regulation_name": "제5조제2항",
          "regulation_content": "제1항에 따른 공시를 하는 경우 금융감독원장에게 그 내용을 지체없이 보고하여야 한다.",
          "type": "항",
          "jo": "5",
          "hang": "2"
        }
