  "articles": [
    {
      "regulation_name": "제1조(적용원칙)",
      "regulation_content": "직원의 취업은 법령·정관으로써 정하여진 것외에 이「취업규칙」과 이에 의하여 제정된 제규정이 정하는 바에 의한다.",
      "type": "조",
      "jo": "1",
      "sub_articles": []
    },
    {
      "regulation_name": "제2조(복무자세)",
      "regulation_content": "",
      "type": "조",
      "jo": "2",
      "sub_articles": [
        {
          "regulation_name": "제2조제1항",
          "regulation_content": "직원은 업무, 관리, 운영의 기본이 되는 법령, 정관, 제규정 및 상직자의 정당한 직무상 명령을 충실히 준수하여야 한다.",
          "type": "항",
          "jo": "2",
          "hang": "1"
        },
        {
          "regulation_name": "제2조제2항",
          "regulation_content": "직원은 성실히 집무하며 항상 맡은 바 직책을 신속 정확하게 수행하여야 한다.",
          "type": "항",
          "jo": "2",
          "hang": "2"
        }
      ]
    },
    {
      "regulation_name": "제3조(자기계발)",
      "regulation_content": "직원은 항상 인격도야와 지식향상을 위한 자기계발에 노력하고 상호 융화하여 업무발전에 기여하여야 한다.",
      "type": "조",
      "jo": "3",
      "sub_articles": []
    },
    {
      "regulation_name": "제4조(품위의 유지)",
      "regulation_content": "직원은 항시 자기의 신분과 지위를 인식하고 언행을 조심하여 당행의 신용과 명예를 손상하는 일이 없도록 하여야 한다.",
      "type": "조",
      "jo": "4",
      "sub_articles": []
    },
    {
      "regulation_name": "제5조(근무태도)",
      "regulation_content": "직원은 항상 검소를 본지로 하여 복장 및 용모를 단정히 함은 물론 예절과 규율을 존중하고 고객에게 친절하여야 한다.",
      "type": "조",
      "jo": "5",
      "sub_articles": []
    },
    {
      "regulation_name": "제6조(비밀누설의 금지)",
      "regulation_content": "직원은 업무수행상 지득한 당행 및 거래처 기타의 비밀을 누설하여서는 아니된다.",
      "type": "조",
      "jo": "6",
      "sub_articles": []
    },
    {
      "regulation_name": "제7조(겸직금지)",
      "regulation_content": "직원은 은행장의 허가없이 영리사업을 영위하거나 다른 직업에 종사하여서는 아니된다.",
      "type": "조",
      "jo": "7",
      "sub_articles": []
    },
    {
      "regulation_name": "제8조(청렴의 의무)",
      "regulation_content": "",
