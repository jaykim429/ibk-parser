# 폐쇄망 컨테이너용 환경변수 예시 — 복사해서 .env.docker 로 사용(저장소 커밋 금지)
# 도커 네트워크의 서비스명 또는 내부 IP를 사용한다.

# ── core-ai (analyze/parse/LLM 생성, 리랭커) ──
CORE_AI_BASE_URL=http://core-ai:5000
RERANK_URL=http://core-ai:5000

# ── Qdrant (벡터 검색) ──
QDRANT_URL=http://qdrant:6333
IBK_REG_COLLECTION=regulations_ibk_test

# ── 임베딩 ──
# ⚠️ 현재 기본값은 OpenRouter(외부망). 진짜 폐쇄망에서는 외부로 못 나가므로
#    반드시 사내 임베딩 엔드포인트(동일 모델/4096차원)로 교체해야 함.
EMBEDDING_API_URL=http://embedding-internal:8080/v1
EMBEDDING_API_KEY=__SET_INTERNAL_KEY__
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=4096

# ── DGX Spark (보고서/OCR LLM) ──
DGX_SPARK_URL=http://172.23.80.102:8000
DGX_SPARK_MODEL=google/gemma-4-26B-A4B-it

# ── ODS RDB (검색 카탈로그 — 현재 UI 미연결, 선택) ──
# ODS_DB_URL=postgresql://user:pass@ods-host:5432/ods?ssl=disable

# ── 타임아웃/튜닝(선택, 기본값은 lib/config.ts) ──
PIPELINE_TIMEOUT_MS=180000
# MATCH_TOPK=30
# RERANK_KEEP=18
# REPORT_CACHE_VERSION=v14
